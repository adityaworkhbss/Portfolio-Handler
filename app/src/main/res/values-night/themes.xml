<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Night theme inherits exactly the same as the day theme.
         The portfolio design is permanently dark mode. -->
    <style name="Theme.PorfolioHandler" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color → Lime accent -->
        <item name="colorPrimary">@color/accent_primary</item>
        <item name="colorPrimaryVariant">@color/accent_deep</item>
        <item name="colorOnPrimary">@color/bg_primary</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/accent_bright</item>
        <item name="colorSecondaryVariant">@color/accent_dim</item>
        <item name="colorOnSecondary">@color/bg_primary</item>

        <!-- Surface & Background -->
        <item name="colorSurface">@color/bg_primary</item>
        <item name="colorOnSurface">@color/fg_primary</item>
        <item name="android:colorBackground">@color/bg_primary</item>
        <item name="colorOnBackground">@color/fg_primary</item>
        <item name="android:windowBackground">@color/bg_primary</item>

        <!-- Error -->
        <item name="colorError">@color/status_error</item>
        <item name="colorOnError">@color/bg_primary</item>

        <!-- Status bar & navigation bar -->
        <item name="android:statusBarColor">@color/bg_primary</item>
        <item name="android:navigationBarColor">@color/bg_primary</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Default text color -->
        <item name="android:textColor">@color/fg_primary</item>
        <item name="android:textColorPrimary">@color/fg_primary</item>
        <item name="android:textColorSecondary">@color/fg_muted</item>
        <item name="android:textColorHint">@color/fg_subtle</item>

        <!-- Material component overrides -->
        <item name="materialButtonStyle">@style/Widget.Portfolio.Button.Primary</item>
        <item name="textInputStyle">@style/Widget.Portfolio.TextInputLayout</item>
        <item name="materialCardViewStyle">@style/Widget.Portfolio.CardView</item>
        <item name="floatingActionButtonStyle">@style/Widget.Portfolio.FAB</item>
        <item name="toolbarStyle">@style/Widget.Portfolio.Toolbar</item>
        <item name="bottomSheetDialogTheme">@style/Theme.Portfolio.BottomSheet</item>
        <item name="chipStyle">@style/Widget.Portfolio.Chip</item>
        <item name="switchStyle">@style/Widget.Portfolio.Switch</item>

        <!-- Ripple -->
        <item name="android:colorControlHighlight">@color/ripple_light</item>
    </style>
</resources>