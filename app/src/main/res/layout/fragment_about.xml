<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@android:color/transparent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Avatar + tap-to-change badge -->
        <FrameLayout
            android:id="@+id/avatarContainer"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginTop="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/avatarImage"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:padding="2dp"
                android:scaleType="centerCrop"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                app:shapeAppearanceOverlay="@style/CircleImage"
                app:strokeColor="@color/accent_primary"
                app:strokeWidth="2dp"
                tools:src="@tools:sample/avatars" />

            <!-- Camera-badge overlay (bottom-right) -->
            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="4dp"
                android:background="@color/accent_primary"
                android:padding="5dp"
                android:src="@android:drawable/ic_menu_camera"
                android:importantForAccessibility="no"
                app:tint="@android:color/white" />

        </FrameLayout>


        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/nameLayout"
            style="@style/Widget.Portfolio.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Full Name"
            app:layout_constraintTop_toBottomOf="@id/avatarContainer">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/nameEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName"
                android:textColor="@color/fg_primary"
                android:text="Aditya Sharma" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/roleLayout"
            style="@style/Widget.Portfolio.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Role"
            app:layout_constraintTop_toBottomOf="@id/nameLayout">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/roleEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:textColor="@color/fg_primary"
                android:text="Android Developer" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/taglineLayout"
            style="@style/Widget.Portfolio.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Tagline"
            app:layout_constraintTop_toBottomOf="@id/roleLayout">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/taglineEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:textColor="@color/fg_primary"
                android:text="Building premium digital experiences" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Availability Status Dropdown -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/availabilityStatusLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Status Color"
            app:boxStrokeColor="@color/border_strong"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:hintTextColor="@color/accent_primary"
            app:layout_constraintTop_toBottomOf="@id/taglineLayout">

            <AutoCompleteTextView
                android:id="@+id/availabilityStatusEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:textColor="@color/fg_primary"
                app:simpleItems="@array/availability_status_options" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Availability Text -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/availabilityTextLayout"
            style="@style/Widget.Portfolio.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Status Message"
            app:layout_constraintTop_toBottomOf="@id/availabilityStatusLayout">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/availabilityTextEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:textColor="@color/fg_primary"
                android:text="Available for Hire" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Stats Section -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/statsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintTop_toBottomOf="@id/availabilityTextLayout"
            tools:listitem="@layout/item_stat" />

        <!-- Bio Section -->
        <TextView
            android:id="@+id/bioLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="About Me"
            android:textAppearance="@style/TextAppearance.Portfolio.Heading"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/statsRecyclerView" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/bioLayout"
            style="@style/Widget.Portfolio.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Bio"
            app:layout_constraintTop_toBottomOf="@id/bioLabel">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/bioEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:minLines="3"
                android:textColor="@color/fg_primary"
                android:text="Bio content goes here..." />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Skills Section -->
        <TextView
            android:id="@+id/skillsLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Skills &amp; Expertise"
            android:textAppearance="@style/TextAppearance.Portfolio.Heading"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/bioLayout" />

        <ImageButton
            android:id="@+id/btnAddSkill"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_input_add"
            app:layout_constraintBottom_toBottomOf="@id/skillsLabel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/skillsLabel"
            app:tint="@color/accent_primary" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/skillsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/skillsLabel"
            tools:listitem="@layout/item_skill_category" />

        <!-- Contact & Location Info -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/infoCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@color/bg_card"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/border_strong"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toBottomOf="@id/skillsRecyclerView">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@android:drawable/ic_dialog_email"
                        app:tint="@color/accent_primary" />
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/emailLayout"
                        style="@style/Widget.Portfolio.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:hint="Email">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/emailEdit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textEmailAddress"
                            android:textColor="@color/fg_primary"
                            android:text="aditya@example.com" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@android:drawable/ic_menu_mylocation"
                        app:tint="@color/accent_primary" />
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/locationLayout"
                        style="@style/Widget.Portfolio.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:hint="Location">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/locationEdit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:textColor="@color/fg_primary"
                            android:text="New Delhi, India" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Social Links -->
        <TextView
            android:id="@+id/socialLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Social Profiles"
            android:textAppearance="@style/TextAppearance.Portfolio.Heading"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/infoCard" />

        <ImageButton
            android:id="@+id/btnAddSocial"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_input_add"
            app:layout_constraintBottom_toBottomOf="@id/socialLabel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/socialLabel"
            app:tint="@color/accent_primary" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/socialRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/socialLabel"
            tools:listitem="@layout/item_social_link" />

        <!-- Update Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/updateAboutButton"
            style="@style/Widget.Portfolio.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:padding="12dp"
            android:text="Update Profile"
            android:enabled="false"
            app:cornerRadius="12dp"
            app:layout_constraintTop_toBottomOf="@id/socialRecyclerView" />

        <!-- Resume Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/resumeButton"
            style="@style/Widget.Portfolio.Button.Outline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:padding="12dp"
            android:text="Update Resume"
            app:cornerRadius="12dp"
            app:icon="@android:drawable/ic_menu_save"
            app:iconTint="@color/fg_primary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/updateAboutButton" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:indeterminateTint="@color/accent_primary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>