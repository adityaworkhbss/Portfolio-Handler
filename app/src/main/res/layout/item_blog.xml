<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/border_default"
    app:strokeWidth="1dp"
    app:rippleColor="@color/ripple_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Title + Published badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/blogTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Blog Title"
                android:textAppearance="@style/TextAppearance.Portfolio.Subtitle" />

            <!-- Published Badge -->
            <TextView
                android:id="@+id/publishedBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_published"
                android:text="Published"
                android:textColor="@color/status_success"
                android:textSize="9sp"
                android:textStyle="bold"
                android:fontFamily="@font/mono"
                android:visibility="gone" />

            <!-- Draft Badge -->
            <TextView
                android:id="@+id/draftBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_draft"
                android:text="Draft"
                android:textColor="@color/status_warning"
                android:textSize="9sp"
                android:textStyle="bold"
                android:fontFamily="@font/mono"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Meta row: date + reading time -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/blogDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="April 19, 2026"
                android:textAppearance="@style/TextAppearance.Portfolio.Caption"
                android:fontFamily="@font/mono" />

            <View
                android:layout_width="4dp"
                android:layout_height="4dp"
                android:layout_marginHorizontal="8dp"
                android:background="@drawable/bg_separator_dot" />

            <TextView
                android:id="@+id/blogReadingTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="7 min read"
                android:textAppearance="@style/TextAppearance.Portfolio.Caption"
                android:fontFamily="@font/mono" />
        </LinearLayout>

        <!-- Tags -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/blogTagsChipGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:chipSpacingHorizontal="8dp"
            app:chipSpacingVertical="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <Button
                android:id="@+id/deleteButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Delete" />

            <Button
                android:id="@+id/publishedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Published" />

        </LinearLayout>
        
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
