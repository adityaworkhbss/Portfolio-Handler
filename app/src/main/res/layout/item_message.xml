<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top row: Name + NEW badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Unread indicator dot -->
            <View
                android:id="@+id/unreadDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="8dp"
                android:background="?attr/colorPrimary"
                android:visibility="gone" />

            <TextView
                android:id="@+id/messageSenderName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Sender Name"
                android:textAppearance="?attr/textAppearanceSubtitle1"
                android:textStyle="bold" />

            <!-- NEW badge -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/newBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/colorPrimary"
                app:cardCornerRadius="4dp"
                app:cardElevation="0dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="1dp"
                    android:text="NEW"
                    android:textColor="?attr/colorOnPrimary"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>

            <ImageButton
                android:id="@+id/deleteMessageButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Delete"
                android:src="@android:drawable/ic_menu_delete" />
        </LinearLayout>

        <!-- Email -->
        <TextView
            android:id="@+id/messageEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="email@example.com"
            android:textAppearance="?attr/textAppearanceCaption"
            android:textColor="?attr/colorPrimary" />

        <!-- Message preview -->
        <TextView
            android:id="@+id/messagePreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:alpha="0.8"
            android:ellipsize="end"
            android:text="Message content preview..."
            android:textAppearance="?attr/textAppearanceBody2" />

        <!-- Timestamp -->
        <TextView
            android:id="@+id/messageTimestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:alpha="0.6"
            android:text="Apr 21, 2026, 12:59 AM"
            android:textAppearance="?attr/textAppearanceCaption" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:id="@+id/visitedMessage"
                android:text="Mark Visit" />

            <Button
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:id="@+id/respondMessage"
                android:text="Respond"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
