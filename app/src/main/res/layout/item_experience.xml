<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- Timeline Indicator -->
        <View
            android:id="@+id/timelineIndicator"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="12dp"
            android:background="?attr/colorPrimary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Role -->
            <TextView
                android:id="@+id/experienceRole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Android Developer"
                android:textAppearance="?attr/textAppearanceSubtitle1"
                android:textStyle="bold" />

            <!-- Company -->
            <TextView
                android:id="@+id/experienceCompany"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Company Name"
                android:textAppearance="?attr/textAppearanceBody2"
                android:textColor="?attr/colorPrimary" />

            <!-- Duration -->
            <TextView
                android:id="@+id/experienceDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:alpha="0.7"
                android:text="Jan 2025 — Present"
                android:textAppearance="?attr/textAppearanceCaption" />

            <!-- Description -->
            <TextView
                android:id="@+id/experienceDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:alpha="0.8"
                android:text="Description of responsibilities"
                android:textAppearance="?attr/textAppearanceBody2"
                android:visibility="gone" />

            <!-- Current Badge -->
            <TextView
                android:id="@+id/currentBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/ic_launcher_background"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="Current"
                android:textColor="#4CAF50"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
