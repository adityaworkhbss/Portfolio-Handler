<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/border_default"
    app:strokeWidth="1dp"
    app:rippleColor="@color/ripple_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- Timeline Indicator -->
        <View
            android:id="@+id/timelineIndicator"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_timeline_indicator" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Role -->
            <TextView
                android:id="@+id/experienceRole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Android Developer"
                android:textAppearance="@style/TextAppearance.Portfolio.Subtitle" />

            <!-- Company -->
            <TextView
                android:id="@+id/experienceCompany"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Company Name"
                android:textAppearance="@style/TextAppearance.Portfolio.Body"
                android:textColor="@color/accent_primary" />

            <!-- Duration -->
            <TextView
                android:id="@+id/experienceDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Jan 2025 — Present"
                android:textAppearance="@style/TextAppearance.Portfolio.Caption"
                android:fontFamily="@font/mono" />

            <!-- Description -->
            <TextView
                android:id="@+id/experienceDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Description of responsibilities"
                android:textAppearance="@style/TextAppearance.Portfolio.Body.Muted"
                android:visibility="gone" />

            <!-- Current Badge -->
            <TextView
                android:id="@+id/currentBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_badge_current"
                android:text="Current"
                android:textColor="@color/status_success"
                android:textSize="10sp"
                android:textStyle="bold"
                android:fontFamily="@font/mono"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
